<Project>
  <!-- dotnet publish src/Thermonitor -p:PublishProfile=SingleExe
       One exe in dist\, framework-dependent (needs the .NET 10 runtime). -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\dist\</PublishDir>
  </PropertyGroup>
</Project>
